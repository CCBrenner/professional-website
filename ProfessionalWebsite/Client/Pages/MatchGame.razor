                        <td class="text-row">
                            Matches: @matchesFound/8
                        </td>
                        <td class="text-row" @onclick="UserSelectsNewGamePrompt">
                            @TimerText<br />
                        </td>
                    }
                    else if (GameStatus == MatchGameStatus.Done)
                    {
                        <td class="text-row">
                            @TimerText&nbsp;
                        </td>
                        <td class="text-row" @onclick="UserSelectsNewGamePrompt">
